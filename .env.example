# # --- Database ---
# # Local Postgres example: postgresql://postgres:postgres@localhost:5432/nirog
# DATABASE_URL="postgresql://user:password@localhost:5432/nirog"

# # --- NextAuth ---
# NEXTAUTH_URL="http://localhost:3000"
# NEXTAUTH_SECRET="replace-with-a-long-random-string"

# # --- App ---
# NEXT_PUBLIC_APP_URL="http://localhost:3000"

# # --- Stripe (card payments) ---
# # Get test keys from https://dashboard.stripe.com/test/apikeys
# STRIPE_SECRET_KEY="sk_test_xxxxxxxxxxxx"
# STRIPE_WEBHOOK_SECRET="whsec_xxxxxxxxxxxx"
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_xxxxxxxxxxxx"

# # --- bKash (Tokenized Checkout, sandbox) ---
# # Sandbox credentials come from https://developer.bka.sh
# BKASH_BASE_URL="https://tokenized.sandbox.bka.sh/v1.2.0-beta"
# BKASH_APP_KEY="sandbox_app_key"
# BKASH_APP_SECRET="sandbox_app_secret"
# BKASH_USERNAME="sandbox_username"
# BKASH_PASSWORD="sandbox_password"

# # --- Nagad (sandbox) ---
# # Nagad requires a merchant RSA keypair issued to you during onboarding.
# # See src/lib/payments/nagad.ts for where these plug in.
# NAGAD_BASE_URL="https://sandbox.mynagad.com:10443/remote-payment-gateway-1.0"
# NAGAD_MERCHANT_ID="sandbox_merchant_id"
# NAGAD_MERCHANT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nPASTE_KEY_HERE\n-----END PRIVATE KEY-----"
# NAGAD_PG_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nPASTE_KEY_HERE\n-----END PUBLIC KEY-----"

# # --- File uploads ---
# # Local disk is used out of the box (public/uploads). Swap UPLOAD_DRIVER
# # to "s3" and fill these in for production use with AWS S3 or S3-compatible storage.
# UPLOAD_DRIVER="local"
# S3_BUCKET=""
# S3_REGION=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
